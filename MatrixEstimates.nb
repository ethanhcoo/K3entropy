Notebook[{

Cell["Exact block-row estimate", "Title"],
Cell["This notebook reproduces the block-row estimate in Section 3.5.2 from the exact rational matrices in Table 4. The final output gives the numerical maximum, checks that all proof data remain exact, and verifies that the maximum is less than 31.13.", "Text"],

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{"(*",
  RowBox[{"Exact", " ", "rational", " ", "matrices", " ",
   RowBox[{SubscriptBox[OverscriptBox["L", "~"], "i"], " ", "from", " ",
    "Table", " ", "4"}]}], "*)"}], "\n",
 RowBox[{
  RowBox[{"tildeL0", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["2159", "10000"]}], ",",
       RowBox[{"-", FractionBox["3755", "10000"]}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["4694", "10000"]}], ",", FractionBox["4623", "10000"]}],
      "}"}]}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL1", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{FractionBox["17718", "10000"], ",",
       RowBox[{"-", FractionBox["21227", "10000"]}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["123247", "10000"]}], ",", FractionBox["163690", "10000"]}],
      "}"}]}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL2", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{FractionBox["3539", "10000"], ",",
       RowBox[{"-", FractionBox["47730", "10000"]}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{FractionBox["4185", "10000"], ",",
       RowBox[{"-", FractionBox["46570", "10000"]}]}], "}"}]}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL3", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["31432", "10000"]}], ",",
       RowBox[{"-", FractionBox["4406", "10000"]}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["916", "10000"]}], ",",
       RowBox[{"-", FractionBox["11425", "10000"]}]}], "}"}]}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL4", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["4583", "10000"]}], ",", FractionBox["1150", "10000"]}], "}"}],
     ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["6163", "10000"]}], ",", FractionBox["8316", "10000"]}],
      "}"}]}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL5", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{FractionBox["14772", "10000"], ",",
       RowBox[{"-", FractionBox["19866", "10000"]}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{FractionBox["3707", "10000"], ",",
       RowBox[{"-", FractionBox["26806", "10000"]}]}], "}"}]}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL6", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["8852", "10000"]}], ",", FractionBox["258", "10000"]}], "}"}],
     ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["1241", "10000"]}], ",", FractionBox["3218", "10000"]}],
      "}"}]}], "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL7", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{FractionBox["10118", "10000"], ",", FractionBox["11967", "10000"]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{FractionBox["136472", "10000"], ",", FractionBox["133154", "10000"]}], "}"}]}],
    "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"tildeL8", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", FractionBox["6239", "10000"]}], ",",
       RowBox[{"-", FractionBox["43400", "10000"]}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{FractionBox["7475", "10000"], ",", FractionBox["57641", "10000"]}], "}"}]}],
    "}"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"tildeL9", "=",
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"-", FractionBox["13601", "10000"]}], ",", FractionBox["16743", "10000"]}], "}"}],
       ",",
      RowBox[{"{",
       RowBox[{
        RowBox[{"-", FractionBox["3730", "10000"]}], ",",
        RowBox[{"-", FractionBox["22037", "10000"]}]}], "}"}]}], "}"}]}], ";"}],
  "\[IndentingNewLine]", "\n",
  RowBox[{"(*",
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":",
    RowBox[{
    "Create", " ", "the", " ", "10", "x10", " ", "permutation", " ",
     "matrix"}]}], "*)"}]}], "\n",
 RowBox[{
  RowBox[{"identityMatrix", "=",
   RowBox[{"IdentityMatrix", "[", "10", "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"permutationMatrix", "=",
    RowBox[{"RotateRight", "[", "identityMatrix", "]"}]}], ";"}],
  "\[IndentingNewLine]", "\[IndentingNewLine]",
  RowBox[{"(*",
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":",
    RowBox[{"Construct", " ", "the", " ", "20", "x20", " ", "cyclic", " ",
     "block", " ", "matrix"}]}],
   "*)"}]}], "\n",
 RowBox[{
  RowBox[{
   RowBox[{"matricesList", "=",
    RowBox[{"{",
     RowBox[{
     "tildeL9", ",", "tildeL0", ",", "tildeL1", ",", "tildeL2", ",",
      "tildeL3", ",", "tildeL4", ",", "tildeL5", ",", "tildeL6", ",",
      "tildeL7", ",", "tildeL8"}], "}"}]}], ";"}],
  "\[IndentingNewLine]", "\n",
  RowBox[{"(*",
   RowBox[{
   "Initialize", " ", "the", " ", "20", "x20", " ", "zero", " ", "matrix"}],
   "*)"}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"tildeL", "=",
    RowBox[{"ConstantArray", "[",
     RowBox[{"0", ",",
      RowBox[{"{",
       RowBox[{"20", ",", "20"}], "}"}]}], "]"}]}], ";"}], "\n",
  "\[IndentingNewLine]",
  RowBox[{"(*",
   RowBox[{
   "Replace", " ", "the", " ", "1", "s", " ", "in", " ", "the", " ",
    "permutation", " ", "matrix", " ", "with", " ", "the", " ", "2", "x2",
    " ", "matrices"}], "*)"}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[",
    RowBox[{
     RowBox[{
      RowBox[{"tildeL", "[",
       RowBox[{"[",
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"2", "*", "i"}], "-", "1"}], ";;",
          RowBox[{"2", "*", "i"}]}], ",",
         RowBox[{
          RowBox[{
           RowBox[{"2", "*", "j"}], "-", "1"}], ";;",
          RowBox[{"2", "*", "j"}]}]}], "]"}], "]"}], "=",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"permutationMatrix", "[",
          RowBox[{"[",
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "1"}], ",",
        RowBox[{"matricesList", "[",
         RowBox[{"[", "i", "]"}], "]"}], ",",
        RowBox[{"{",
         RowBox[{
          RowBox[{"{",
           RowBox[{"0", ",", "0"}], "}"}], ",",
          RowBox[{"{",
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "]"}]}], ",",
     RowBox[{"{",
      RowBox[{"i", ",", "10"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"j", ",", "10"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]",
  "\n",
  RowBox[{"(*",
   RowBox[{"Invert", " ",
    RowBox[{OverscriptBox["L", "~"], "-", SubscriptBox["I", "20"]}],
    " ", "and", " ", "extract", " ", "its", " ", "2", "x2", " ",
    "blocks"}], "*)"}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"Id", "=",
   RowBox[{"IdentityMatrix", "[", "20", "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"Mat", "=",
   RowBox[{"tildeL", "-", "Id"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"B", "=",
   RowBox[{"Inverse", "[", "Mat", "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"blocks", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"B", "[",
      RowBox[{"[",
       RowBox[{
        RowBox[{
         RowBox[{RowBox[{"2", "*", "i"}], "-", "1"}], ";;",
         RowBox[{"2", "*", "i"}]}], ",",
        RowBox[{
         RowBox[{RowBox[{"2", "*", "j"}], "-", "1"}], ";;",
         RowBox[{"2", "*", "j"}]}]}], "]"}], "]"}], ",",
     RowBox[{"{", RowBox[{"i", ",", "10"}], "}"}], ",",
     RowBox[{"{", RowBox[{"j", ",", "10"}], "}"}]}], "]"}]}], ";"}],
 "\n",
 RowBox[{
  RowBox[{"rowSums", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"Sum", "[",
      RowBox[{
       RowBox[{"Norm", "[",
        RowBox[{
         RowBox[{"blocks", "[",
          RowBox[{"[", RowBox[{"i", ",", "j"}], "]"}], "]"}], ",",
         "\"\<Frobenius\>\""}], "]"}], ",",
       RowBox[{"{", RowBox[{"j", ",", "10"}], "}"}]}], "]"}], ",",
     RowBox[{"{", RowBox[{"i", ",", "10"}], "}"}]}], "]"}]}], ";"}],
 "\n",
 RowBox[{
  RowBox[{"maxRowSum", "=", RowBox[{"Max", "[", "rowSums", "]"}]}],
  ";"}], "\n",
 RowBox[{
  RowBox[{"exactData", "=",
   RowBox[{"FreeQ", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"matricesList", ",", "tildeL", ",", "B", ",",
       "rowSums"}], "}"}], ",", RowBox[{"_", "Real"}]}], "]"}]}],
  ";"}], "\n",
 RowBox[{
  RowBox[{"exactBound", "=",
   RowBox[{"AllTrue", "[",
    RowBox[{"rowSums", ",",
     RowBox[{"Function", "[",
      RowBox[{"s", ",",
       RowBox[{"TrueQ", "[",
        RowBox[{"FullSimplify", "[",
         RowBox[{"s", "<", FractionBox["3113", "100"]}], "]"}],
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n",
 RowBox[{"{",
  RowBox[{
   RowBox[{"N", "[", RowBox[{"maxRowSum", ",", "16"}], "]"}], ",",
   "exactData", ",", "exactBound"}], "}"}], "\n"}], "Input",
 ExpressionUUID->"d2f3b245-7f8b-43b7-8e38-d00a39f64df4"]
}, Open  ]]
},
